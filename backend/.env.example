# Copy to backend/.env and fill in. Never commit the real .env.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg://iniba:iniba@localhost:5432/iniba

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24

ALLOWED_EMAIL_DOMAIN=khi.iba.edu.pk
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Daily IBA Moment: random time between these Karachi hours, open for this many seconds
MOMENT_EARLIEST=09:00
MOMENT_LATEST=21:00
MOMENT_DURATION_SECONDS=120

# Only used by scripts/seed.py to create sample users and the admin
SEED_PASSWORD=
SEED_ADMIN_EMAIL=admin@khi.iba.edu.pk
