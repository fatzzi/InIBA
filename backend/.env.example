# Copy to backend/.env and fill in. Never commit the real .env.
# This file is for running the backend on your laptop. The public API's values live in the Render dashboard.

# "production" only on the hosted API: it then refuses to start with unsafe settings (app/config.py).
ENVIRONMENT=development

# Local Postgres from docker-compose.yml (only you see this data)
DATABASE_URL=postgresql+psycopg://iniba:iniba@localhost:5432/iniba

# The real shared database is used by the hosted API only. Point your laptop at it only to debug live data.
# Supabase > Connect > "Session pooler" URI, with "postgresql://" changed to "postgresql+psycopg://".
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Where uploaded images go. "local" = backend/media on this machine. "supabase" = the shared public bucket.
IMAGE_STORE=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24

ALLOWED_EMAIL_DOMAIN=khi.iba.edu.pk
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Only used by scripts/seed.py to create sample users and the admin
SEED_PASSWORD=
SEED_ADMIN_EMAIL=admin@khi.iba.edu.pk
